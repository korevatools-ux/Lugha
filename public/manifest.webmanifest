  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Today's lesson", "url": "/app/#learn", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Words", "url": "/app/#words", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Listening", "url": "/app/#listen", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "AI tutor", "url": "/app/#tutor", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
