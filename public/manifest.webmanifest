{
  "id": "/app/",
  "name": "Lugha — Language for everyone",
  "short_name": "Lugha",
  "description": "Free language learning: 256 languages, levels A1 to B2, native voices, an AI tutor and exam practice.",
  "start_url": "/app/",
  "scope": "/",
  "display": "standalone",
